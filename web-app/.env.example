# Firebase Alias Keys (Backward Compatibility)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_REGION=asia-east2
VITE_USE_FIREBASE_EMULATOR=false

# 🏫 Institutional Email Domain Configuration (Multi-School Support)
# Comma-separated list of permitted domains for instructors and teachers (or * for open)
VITE_TEACHER_DOMAINS=vtc.edu.hk
# Comma-separated list of permitted domains for students (or * for open)
VITE_STUDENT_DOMAINS=stu.vtc.edu.hk
# Name of institution for branding in login/auth dialogs
VITE_INSTITUTION_NAME=VTC

# 🔍 Optional: Username Regex for Same-Domain Schools (e.g. both use @school.edu)
# VITE_STUDENT_USERNAME_REGEX=^[0-9]{8}$|^s[0-9]{7}$
# VITE_TEACHER_USERNAME_REGEX=^[a-zA-Z]+\.[a-zA-Z]+$
# VITE_DEFAULT_TO_STUDENT=true

# 📁 Google Drive Integration (OAuth 2.0 Web Client ID)
# ⚠️ WARNING: If not configured, direct browser-to-Drive cloud upload in Teacher Lecture Recordings will be disabled.
# Instructions to set up:
#   1. Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#   2. Application type: Web application
#   3. Authorized JavaScript origins: https://<project-id>.web.app (and http://localhost:5173 for local dev)
#   4. OAuth Consent Screen Scopes: add https://www.googleapis.com/auth/drive.file
#   5. Add your client ID below in web-app/.env.prod (for production) or web-app/.env.dev (for dev):
# VITE_GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com


