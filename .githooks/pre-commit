#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Secret Scanner Hook
# Prevents accidental commits of API keys, credentials, and cloud secrets.
# ==============================================================================

set -eo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# 1. If ggshield (GitGuardian CLI) is installed and authenticated, run it first
if command -v ggshield >/dev/null 2>&1; then
  # Check if authenticated or API key is set
  if [ -n "$GITGUARDIAN_API_KEY" ] || ggshield auth status >/dev/null 2>&1; then
    echo -e "${CYAN}🔍 Running GitGuardian ggshield pre-commit scan...${NC}"
    if ! ggshield secret scan pre-commit; then
      echo -e "${RED}${BOLD}🛑 GitGuardian ggshield detected secrets in staged files! Commit rejected.${NC}"
      exit 1
    fi
  fi
fi

# 2. Local Built-in Zero-Dependency Secret Scanner on staged diffs
# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

HAS_SECRET=0

# Patterns to scan for
# Google API Keys (e.g. AIzaSy...)
GOOGLE_KEY_REGEX='AIza[0-9A-Za-z_-]{35}'
# Private Keys
PRIVATE_KEY_REGEX='-----BEGIN[ A-Z0-9_-]*PRIVATE KEY-----'
# AWS Access Keys
AWS_KEY_REGEX='(A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}'
# GitHub Tokens
GITHUB_PAT_REGEX='(ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{82})'
# Slack Tokens
SLACK_TOKEN_REGEX='xox[baprs]-[0-9a-zA-Z]{10,48}'

for FILE in $STAGED_FILES; do
  # Never allow committing sensitive env files (except .env.example)
  if [[ "$FILE" =~ \.env(\..+)?$ ]] && [[ "$FILE" != *".env.example" ]]; then
    echo -e "${RED}${BOLD}🛑 SECRET LEAK BLOCKED:${NC} Attempting to commit an environment file: ${BOLD}$FILE${NC}"
    echo -e "${YELLOW}   Environment files must remain strictly untracked (.gitignore).${NC}"
    HAS_SECRET=1
    continue
  fi

  # Skip binary files or lock files
  if [[ "$FILE" =~ \.(png|jpg|jpeg|gif|ico|pdf|pptx|wasm|bin|lock)$ ]]; then
    continue
  fi

  # Scan added/modified lines in this staged file
  ADDED_LINES=$(git diff --cached -U0 "$FILE" | grep '^[+]' | grep -v '^[+][+][+]' || true)

  if [ -z "$ADDED_LINES" ]; then
    continue
  fi

  # Check Google API Key
  MATCH=$(echo "$ADDED_LINES" | grep -E -o "$GOOGLE_KEY_REGEX" || true)
  if [ -n "$MATCH" ]; then
    # Allow legitimate documentation placeholders like AIzaSy...
    REAL_MATCH=$(echo "$MATCH" | grep -v 'AIzaSy\.\.\.' || true)
    if [ -n "$REAL_MATCH" ]; then
      echo -e "${RED}${BOLD}🛑 SECRET LEAK BLOCKED:${NC} Google API Key detected in ${BOLD}$FILE${NC}"
      echo -e "${RED}   Pattern matched:${NC} ${REAL_MATCH:0:12}************************"
      echo -e "${YELLOW}   Do not hardcode API keys in code. Use environment variables or web-app/.env (untracked).${NC}"
      HAS_SECRET=1
    fi
  fi

  # Check Private Keys
  if echo "$ADDED_LINES" | grep -E -q -- "$PRIVATE_KEY_REGEX"; then
    echo -e "${RED}${BOLD}🛑 SECRET LEAK BLOCKED:${NC} Private Key header detected in ${BOLD}$FILE${NC}"
    HAS_SECRET=1
  fi

  # Check AWS Keys
  if echo "$ADDED_LINES" | grep -E -q -- "$AWS_KEY_REGEX"; then
    echo -e "${RED}${BOLD}🛑 SECRET LEAK BLOCKED:${NC} AWS Access Key ID detected in ${BOLD}$FILE${NC}"
    HAS_SECRET=1
  fi

  # Check GitHub Tokens
  if echo "$ADDED_LINES" | grep -E -q -- "$GITHUB_PAT_REGEX"; then
    echo -e "${RED}${BOLD}🛑 SECRET LEAK BLOCKED:${NC} GitHub Personal Access Token detected in ${BOLD}$FILE${NC}"
    HAS_SECRET=1
  fi

  # Check Slack Tokens
  if echo "$ADDED_LINES" | grep -E -q -- "$SLACK_TOKEN_REGEX"; then
    echo -e "${RED}${BOLD}🛑 SECRET LEAK BLOCKED:${NC} Slack Token detected in ${BOLD}$FILE${NC}"
    HAS_SECRET=1
  fi
done

if [ "$HAS_SECRET" -ne 0 ]; then
  echo -e "\n${RED}${BOLD}❌ Commit aborted to prevent secret exposure.${NC}"
  echo -e "${YELLOW}Please remove the sensitive credentials and re-stage your changes before committing.${NC}\n"
  exit 1
fi

exit 0
