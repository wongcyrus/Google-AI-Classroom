rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /screenshots/{classId}/{userId}/{fileName} {
      // Allow authenticated users to write to their own folder within a class.
      // The userId in the path MUST match the user's own UID.
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 2097152 && // 2 MB, configured in functions/config.js
                      request.resource.contentType.matches('image/.*');

      // Allow authenticated users to read screenshots
      allow read: if request.auth != null;

      // Allow authenticated teachers to delete.
      allow delete: if request.auth != null && request.auth.token.role == 'teacher';
    }

    match /audio/{classId}/{userId}/{fileName} {
      // Allow authenticated students to upload audio segments to their own folder within a class.
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 5242880 && // 5 MB
                      request.resource.contentType.matches('audio/.*');

      // Allow authenticated users (teachers and students) to read any audio file
      allow read: if request.auth != null;

      // Allow authenticated teachers to delete.
      allow delete: if request.auth != null && request.auth.token.role == 'teacher';
    }

    match /irregularities/{classId}/{userId}/{fileName} {
      // Allow authenticated students to upload incident evidence screenshots and audio snippets
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 5242880 && // 5 MB
                      (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('audio/.*'));

      // Teachers and students can read
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.role == 'teacher';
    }

    match /temp_ai/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /mock/{allPaths=**} {
      allow read: if request.auth != null;
    }

    match /videos/{classId}/{videoId} {
      // Allow authenticated teachers to read any video in a class.
      // Students can only read non-exam videos that belong to them.
      allow read: if request.auth != null && (
        request.auth.token.role == 'teacher' ||
        (
          resource.metadata != null &&
          'studentUid' in resource.metadata &&
          resource.metadata.studentUid == request.auth.uid &&
          (!('isExam' in resource.metadata) || resource.metadata.isExam != 'true')
        )
      );
      allow delete: if request.auth != null && request.auth.token.role == 'teacher';
    }

    match /zips/{classId}/{zipFilename} {
      // Allow authenticated teachers to read any zip archive in a class.
      allow read: if request.auth != null && request.auth.token.role == 'teacher';
      allow delete: if request.auth != null && request.auth.token.role == 'teacher';
    }
  }
}
